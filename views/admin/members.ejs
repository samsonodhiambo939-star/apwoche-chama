<% header('Manage Members'); %>
<div class="flex mb-16">
  <div><div class="page-title" style="margin-bottom:4px;">Members</div><p class="text-muted text-sm">Manage all registered members and their accounts</p></div>
  <button class="btn btn-primary btn-lg" onclick="document.getElementById('addForm').style.display='block'" style="flex-shrink:0;">+ Add Member</button>
</div>

<% if (error) { %><div class="alert alert-error"><span class="alert-icon">❌</span><%= error %></div><% } %>
<% if (message) { %><div class="alert alert-success"><span class="alert-icon">✅</span><%= message %></div><% } %>

<div id="addForm" style="display:none;" class="card">
  <div class="card-header"><h3>Add New Member</h3></div>
  <form method="POST" action="/admin/members/add">
    <div class="form-row">
      <div class="form-group"><label>First Name</label><input name="first_name" required></div>
      <div class="form-group"><label>Last Name</label><input name="last_name" required></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Phone (optional)</label><input name="phone"></div>
      <div class="form-group"><label>Username</label><input name="username" required></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Password</label><input type="text" name="password" required></div>
      <div class="form-group" style="display:flex;align-items:flex-end;gap:8px;">
        <button class="btn btn-primary">Add Member</button>
        <button type="button" class="btn btn-outline" onclick="document.getElementById('addForm').style.display='none'">Cancel</button>
      </div>
    </div>
  </form>
</div>

<div class="card">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <h3>All Members</h3>
    <input id="memberSearch" placeholder="Search members..." style="padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;width:280px;max-width:100%;background:var(--input-bg);color:var(--text);">
  </div>
  <div class="table-wrap">
    <table>
      <tr><th>#</th><th>Name</th><th>Phone</th><th>Username</th><th style="text-align:right">Balance</th><th>Status</th><th>Actions</th></tr>
      <% members.forEach(m => { %>
        <tr>
          <td><span class="badge badge-closed"><%= m.member_number %></span></td>
          <td><strong><%= m.first_name %> <%= m.last_name %></strong></td>
          <td class="text-muted"><%= m.phone || '—' %></td>
          <td class="font-mono"><%= m.username || '—' %></td>
          <td style="text-align:right;font-weight:700;">KES <%= Number(m.total_balance || 0).toLocaleString() %></td>
          <td><span class="badge <%= m.is_active ? 'badge-active' : 'badge-closed' %>"><%= m.is_active ? 'Active' : 'Inactive' %></span></td>
          <td>
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
              <a href="/admin/members/<%= m.id %>/contributions" class="btn btn-sm btn-outline">View</a>
              <form method="POST" action="/admin/members/reset-password/<%= m.id %>" style="display:flex;gap:6px;align-items:center;">
                <input type="text" name="password" placeholder="New password" style="padding:6px 10px;border:1.5px solid #e2e8f0;border-radius:6px;font-size:12px;width:110px;" required>
                <button class="btn btn-primary btn-sm">Reset</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>
</div>

<script>
  if (window.location.hash === '#add') document.getElementById('addForm').style.display = 'block';
  document.getElementById('memberSearch').addEventListener('input', function(){
    var v = this.value.toLowerCase();
    document.querySelectorAll('.card table tr').forEach(function(tr,i){
      if(i===0) return;
      tr.style.display = tr.textContent.toLowerCase().includes(v) ? '' : 'none';
    });
  });
</script>
