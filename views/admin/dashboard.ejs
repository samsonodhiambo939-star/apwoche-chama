<% header('Admin Dashboard'); %>
<div class="page-title">Admin Dashboard</div>
<p class="page-subtitle">Overview of the Apwoche Chama System</p>

<div class="grid">
  <div class="stat-card">
    <div class="stat-icon" style="background:#eff6ff;color:#3b82f6;">👥</div>
    <div class="stat-value"><%= stats.total_members %></div>
    <div class="stat-label">Active Members</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width:100%;background:#3b82f6;"></div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:#f0fdf4;color:#22c55e;">📅</div>
    <div class="stat-value"><%= stats.total_cycles %></div>
    <div class="stat-label">Total Cycles</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width:70%;background:#22c55e;"></div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:#fef3c7;color:#f59e0b;">🏦</div>
    <div class="stat-value"><%= stats.active_loans %></div>
    <div class="stat-label">Active Loans</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width:40%;background:#f59e0b;"></div></div>
  </div>
</div>

<div class="card" style="margin-top:24px;">
  <div class="card-header"><h2>Fund Balances</h2></div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;">
    <% var fundColors = { Welfare: { bg: '#fef2f2', color: '#ef4444', icon: '🛡️' }, Savings: { bg: '#f0fdf4', color: '#22c55e', icon: '💰' }, Loans: { bg: '#fef3c7', color: '#f59e0b', icon: '🏦' }, Development: { bg: '#f5f3ff', color: '#8b5cf6', icon: '📈' } }; %>
    <% fundBalances.forEach(function(f) { var fc = fundColors[f.name] || { bg: '#f1f5f9', color: '#64748b', icon: '📊' }; %>
      <div style="background:<%= fc.bg %>;border-radius:12px;padding:16px;text-align:center;">
        <div style="font-size:28px;margin-bottom:4px;"><%= fc.icon %></div>
        <div style="font-size:12px;color:#64748b;text-transform:uppercase;font-weight:600;letter-spacing:0.5px;"><%= f.name %></div>
        <div style="font-size:22px;font-weight:800;color:<%= fc.color %>;margin-top:4px;">KES <%= Number(f.total).toLocaleString() %></div>
      </div>
    <% }); %>
    <div style="background:#fef2f2;border-radius:12px;padding:16px;text-align:center;">
      <div style="font-size:28px;margin-bottom:4px;">⚖️</div>
      <div style="font-size:12px;color:#64748b;text-transform:uppercase;font-weight:600;letter-spacing:0.5px;">Fines</div>
      <div style="font-size:22px;font-weight:800;color:#ef4444;margin-top:4px;">KES <%= Number(totalFines).toLocaleString() %></div>
    </div>
    <div style="background:#e0f7fa;border-radius:12px;padding:16px;text-align:center;">
      <div style="font-size:28px;margin-bottom:4px;">💳</div>
      <div style="font-size:12px;color:#64748b;text-transform:uppercase;font-weight:600;letter-spacing:0.5px;">Member Card</div>
      <div style="font-size:22px;font-weight:800;color:#006d77;margin-top:4px;">KES <%= Number(totalMemberCard).toLocaleString() %></div>
    </div>
  </div>
</div>

<% if (pendingContribs > 0 || pendingLoans > 0 || pendingPayments > 0) { %>
  <div class="alert alert-warning">
    <span class="alert-icon">⏳</span>
    <span style="flex:1">
      <strong>Pending Approvals:</strong>
      <%= pendingContribs %> contribution<%= pendingContribs !== 1 ? 's' : '' %>
      <% if (pendingLoans > 0) { %> &middot; <%= pendingLoans %> loan<%= pendingLoans !== 1 ? 's' : '' %><% } %>
      <% if (pendingPayments > 0) { %> &middot; <%= pendingPayments %> repayment<%= pendingPayments !== 1 ? 's' : '' %><% } %>
    </span>
    <a href="/admin/approvals" class="btn btn-warning btn-sm">Review All</a>
  </div>
<% } %>

<div class="card">
  <div class="card-header"><h2>Recent Activity</h2></div>
  <% if (recentContributions.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">📋</div>
      <div class="empty-text">No activity yet across the system.</div>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <tr><th>Member</th><th>Fund</th><th style="text-align:right">Amount</th><th>Status</th><th>Date</th></tr>
        <% recentContributions.forEach(c => { %>
          <tr>
            <td><strong><%= c.member %></strong></td>
            <td><%= c.fund %></td>
            <td style="text-align:right;font-weight:700;">KES <%= Number(c.amount).toLocaleString() %></td>
            <td><span class="badge badge-<%= c.status %>"><%= c.status %></span></td>
            <td><%= new Date(c.created_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </table>
    </div>
  <% } %>
</div>
